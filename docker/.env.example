# Kopiraj ovaj fajl u ".env" na VPS-u i popuni stvarnim vrijednostima. ".env" je već
# pokriven root .gitignore pravilom (*.env) — nikad se ne commita.

# --- DuckDNS domena (bez "https://") ---
# DuckDNS ne podržava poddomene poddomena (npr. api.sliptrack.duckdns.org ne bi radio),
# pa se cijela produkcija drži na JEDNOJ domeni — admin/backend razdvojeni po putu
# (/api/...), MinIO po portu (9443). Vidi docker/nginx/conf.d/app.conf.
DUCKDNS_DOMAIN=CHANGE_ME.duckdns.org

# --- PostgreSQL ---
POSTGRES_DB=sliptrack
POSTGRES_USER=sliptrack
POSTGRES_PASSWORD=CHANGE_ME_jaka_lozinka

# --- MinIO ---
MINIO_ROOT_USER=sliptrack
MINIO_ROOT_PASSWORD=CHANGE_ME_jaka_lozinka

# --- JWT ---
# Generiraj novi, ne koristi dev vrijednost iz application.properties. Npr:
#   openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generiraj_novi_random_secret
