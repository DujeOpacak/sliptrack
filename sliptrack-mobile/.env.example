# Kopiraj u ".env" lokalno (gitignored) — postavlja LAN IP backend adrese za Expo Go/dev
# client rad. Mijenjati kad se mreža/IP računala promijeni. Produkcijska vrijednost se ne
# postavlja ovdje nego u eas.json (build.preview.env / build.production.env).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.2:8080/api
